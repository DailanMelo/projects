@Composable
fun EditarRegistroScreen(
    registroId: Int, // Identificador do registro a ser editado
    viewModel: EditarRegistroViewModel = viewModel()
) {
    val state = viewModel.uiState.collectAsState()

    // Carregar dados do registro
    LaunchedEffect(registroId) {
        viewModel.carregarRegistro(registroId)
    }

    Column(modifier = Modifier.padding(16.dp)) {
        OutlinedTextField(
            value = state.value.descricao,
            onValueChange = { viewModel.updateDescricao(it) },
            label = { Text("Descrição") },
            modifier = Modifier.fillMaxWidth(),
        )

        OutlinedTextField(
            value = state.value.valor,
            onValueChange = { viewModel.updateValor(it) },
            label = { Text("Valor") },
            keyboardOptions = KeyboardOptions.Default.copy(keyboardType = KeyboardType.Number),
            modifier = Modifier.fillMaxWidth(),
        )

        DropdownMenu(
            expanded = state.value.isCategoriaExpanded,
            onDismissRequest = { viewModel.toggleCategoriaMenu(false) }
        ) {
            listOf("Categoria 1", "Categoria 2").forEach { categoria ->
                DropdownMenuItem(
                    text = { Text(categoria) },
                    onClick = { viewModel.updateCategoria(categoria) }
                )
            }
        }

        Button(onClick = { viewModel.salvarAlteracoes() }) {
            Text("Salvar Alterações")
        }
    }
}

class EditarRegistroViewModel : ViewModel() {
    private val _uiState = mutableStateOf(EditarRegistroState())
    val uiState: State<EditarRegistroState> = _uiState

    fun carregarRegistro(id: Int) {
        // Simula carregamento dos dados
        _uiState.value = EditarRegistroState(
            descricao = "Registro $id",
            valor = "100.00",
            categoria = "Categoria 1"
        )
    }

    fun updateDescricao(value: String) {
        _uiState.value = _uiState.value.copy(descricao = value)
    }

    fun updateValor(value: String) {
        _uiState.value = _uiState.value.copy(valor = value)
    }

    fun updateCategoria(value: String) {
        _uiState.value = _uiState.value.copy(categoria = value, isCategoriaExpanded = false)
    }

    fun toggleCategoriaMenu(expanded: Boolean) {
        _uiState.value = _uiState.value.copy(isCategoriaExpanded = expanded)
    }

    fun salvarAlteracoes() {
        // Lógica para salvar alterações
    }
}

data class EditarRegistroState(
    val descricao: String = "",
    val valor: String = "",
    val categoria: String = "",
    val isCategoriaExpanded: Boolean = false
)
